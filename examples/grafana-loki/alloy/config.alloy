otelcol.receiver.otlp "browser" {
  http {
    endpoint = "0.0.0.0:4318"

    cors {
      allowed_origins = ["http://localhost:8080"]
      allowed_headers = ["Content-Type", "Content-Encoding"]
    }
  }

  output {
    logs    = [otelcol.exporter.otlphttp.loki.input]
    metrics = [otelcol.processor.deltatocumulative.default.input]
    traces  = [otelcol.exporter.debug.traces.input]
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

// Som sends delta metrics; Prometheus only accepts cumulative ones.
otelcol.processor.deltatocumulative "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
  }
}

otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

// Traces are accepted and discarded; there is no trace backend in this stack.
otelcol.exporter.debug "traces" {
  verbosity = "basic"
}
