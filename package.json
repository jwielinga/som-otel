{
  "name": "som-otel",
  "version": "0.1.0",
  "description": "Lightweight browser SDK for sending OpenTelemetry logs and spans over OTLP/HTTP",
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "author": "J Wielinga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwielinga/som-otel.git"
  },
  "bugs": {
    "url": "https://github.com/jwielinga/som-otel/issues"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "otlp",
    "logs",
    "tracing",
    "browser"
  ],
  "license": "EUPL-1.2",
  "homepage": "https://jwielinga.github.io/som-otel/",
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/som.cjs",
  "module": "./dist/som.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/som.iife.js",
  "jsdelivr": "./dist/som.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/som.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/som.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/emit-cjs-types.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "docs:start": "pnpm --dir website start",
    "docs:build": "pnpm --dir website build",
    "test": "vitest run",
    "test:collector": "vitest run --config vitest.collector.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
